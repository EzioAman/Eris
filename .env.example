# =====================================================================
# ERIS Core OS - Environment Configuration Template
# =====================================================================
# Copy or rename this file to `.env` in the project root and fill in your keys, This will enable Dev Mode.

# ---------------------------------------------------------------------
# Primary Model Providers
# ---------------------------------------------------------------------
# Google Gemini API Key (Required for default Gemini models e.g. gemini/gemini-3.6-flash)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenRouter API Key (Supports free & paid models: deepseek, meta-llama, nex-agi, etc.)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM API Key (Supports nvidia_nim/* models)
# Get a key from: https://build.nvidia.com/
NVIDIA_API_KEY=

# ---------------------------------------------------------------------
# Model Runtime Overrides (Optional)
# ---------------------------------------------------------------------
# Preferred active model identifier (e.g. gemini/gemini-3.6-flash, openrouter/nex-agi/nex-n2.5-pro:free)
# ERIS_MODEL=gemini/gemini-3.6-flash

# ---------------------------------------------------------------------
# Email / SMTP Configuration (Optional - for OTP auth & Gmail tool)
# ---------------------------------------------------------------------
# Gmail address and Google App Password for SMTP-based email (OTP verification, contact form)
# Generate an App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=your.email@gmail.com

# ---------------------------------------------------------------------
# Google OAuth (Optional - for "Sign in with Google" & Gmail API email)
# ---------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# LangSmith Observability & LLM Evaluations (Optional)
# ---------------------------------------------------------------------
# Enable tracing and evals by creating a free account at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=eris
